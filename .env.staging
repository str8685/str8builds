# STR8 BUILD Staging Environment Variables

# Database Configuration
DATABASE_URL=your_staging_database_url_here

# AI Features
# GEMINI_API_KEY=your_staging_api_key_here

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_staging_sendgrid_api_key_here
FROM_EMAIL=notifications-staging@str8build.co.nz

# Server Configuration
PORT=8080
NODE_ENV=staging

# Feature Flags - Enable/disable features in staging
ENABLE_CONSTRUCTION_TOOLS=true
ENABLE_PROJECT_CAM=true
ENABLE_SOUND_METER=true
